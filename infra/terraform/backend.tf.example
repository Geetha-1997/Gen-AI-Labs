# Rename this file to backend.tf after creating the bucket and DynamoDB lock table.
# Replace the bucket name with the value printed by scripts/bootstrap-tfstate.ps1.
terraform {
  backend "s3" {
    bucket         = "REPLACE_WITH_TERRAFORM_STATE_BUCKET"
    key            = "gen-ai-labs/production/terraform.tfstate"
    region         = "ap-south-1"
    encrypt        = true
    dynamodb_table = "gen-ai-labs-terraform-locks"
  }
}
