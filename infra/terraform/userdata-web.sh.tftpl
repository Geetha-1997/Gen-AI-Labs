#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/genai-bootstrap.log | logger -t genai-bootstrap -s 2>/dev/console) 2>&1
dnf update -y
dnf install -y docker
systemctl enable --now docker
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${frontend_repo}
docker pull ${frontend_repo}:${image_tag} || true
mkdir -p /opt/genai
cat >/opt/genai/default.conf <<'NGINX'
server {
 listen 8080;
 server_name _;
 root /usr/share/nginx/html;
 index index.html;
 add_header X-Content-Type-Options nosniff always;
 add_header X-Frame-Options DENY always;
 add_header Referrer-Policy strict-origin-when-cross-origin always;
 location ^~ /health/ { proxy_pass http://${internal_alb}:8000; }
 location /api/ { proxy_pass http://${internal_alb}:8000; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_read_timeout 180s; proxy_buffering off; }
 location = /docs { proxy_pass http://${internal_alb}:8000/docs; }
 location = /openapi.json { proxy_pass http://${internal_alb}:8000/openapi.json; }
 location / { try_files $uri $uri/ /index.html; }
}
NGINX
chmod 644 /opt/genai/default.conf
if docker image inspect ${frontend_repo}:${image_tag} >/dev/null 2>&1; then
 docker rm -f genai-web || true
 docker run -d --name genai-web --restart unless-stopped --log-driver=awslogs --log-opt awslogs-region=${region} --log-opt awslogs-group=${log_group} --log-opt awslogs-stream=web-$(hostname) -p 8080:8080 -v /opt/genai/default.conf:/etc/nginx/conf.d/default.conf:ro ${frontend_repo}:${image_tag}
fi
