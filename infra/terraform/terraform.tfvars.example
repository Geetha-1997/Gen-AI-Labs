aws_region = "ap-south-1"
project_name = "gen-ai-labs"
environment = "production"
instance_type = "t3.small"
web_desired_capacity = 2
app_desired_capacity = 2
web_min_size = 2
web_max_size = 4
app_min_size = 2
app_max_size = 4
db_instance_class = "db.t4g.micro"
db_name = "genailabs"
db_username = "genaiadmin"
domain_name = ""
hosted_zone_id = ""
acm_certificate_arn = ""
enable_deletion_protection = true
alarm_email = "" # Optional; confirm the SNS subscription email after apply.
# The app origin defaults to your domain name, or to the ALB DNS name.
# Do not put passwords or API keys in this file.
# Supply TF_VAR_db_password, TF_VAR_jwt_secret and TF_VAR_groq_api_key as environment variables.

# ASGs start with two instances per tier and can scale to four on CPU load. This increases cost when scaled out.
